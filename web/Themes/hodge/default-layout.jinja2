{% set links = obj.links %}
{% set doc = obj.ownerDocument.getElementsByTagName('document')[0] %}
{% set toc = doc.tableofcontents %}
{% set rendererdata = obj.ownerDocument.rendererdata['html5'] %}
{% macro tocEntry(section) %}<span class="toc_ref">{{ section.ref.textContent }}</span> <span class="toc_entry">{{ section.tocEntry }}</span>{% endmacro %}
{% macro isActive(section) %}{% if section in links.breadcrumbs %} active{% endif %}{% endmacro %}
{% macro isCurrent(section) %}{% if section.url == obj.url %} current{% endif %}{% endmacro %}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="{{ config.files['output-encoding'] }}" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content="plasTeX" />
<title>{{ obj.title | striptags }} - {{ links.document.title | striptags }}</title>
<script>
  try { var t = localStorage.getItem("hodge-theme"); if (t === "light" || t === "dark") document.documentElement.setAttribute("data-theme", t); } catch (e) {}
</script>
{# MathJax 2.7.9 with HTML-CSS output: formulas are real, selectable text. #}
<script type="text/x-mathjax-config">
MathJax.Hub.Config({
  tex2jax: { inlineMath: [["\\(", "\\)"]], displayMath: [["\\[", "\\]"]], processEscapes: true, processEnvironments: true },
  TeX: { extensions: ["AMSmath.js", "AMSsymbols.js"], equationNumbers: { autoNumber: "none" } },
  "HTML-CSS": { availableFonts: ["TeX"], imageFont: null },
  messageStyle: "none"
});
</script>
<script src="{{ config.html5['mathjax-url'] }}"></script>
{% if links.prev.url %}<link rel="prev" href="{{ links.prev.url }}" />{% endif %}
{% if links.next.url %}<link rel="next" href="{{ links.next.url }}" />{% endif %}
{% for css in rendererdata.get('css', []) %}
<link rel="stylesheet" href="styles/{{ css }}" />
{% endfor %}
</head>

<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <button id="toc-toggle" class="icon-button toc-button" type="button" aria-label="Table of contents" aria-controls="site-toc" aria-expanded="false">
    <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
  </button>
  <a class="site-title" href="index.html">{{ links.document.title | striptags }}</a>
  <form class="site-search" id="site-search" action="search.html" method="get" role="search">
    <label class="visually-hidden" for="search-input">Search the project, or go to a tag</label>
    <input id="search-input" name="q" type="search" placeholder="Search or tag" autocomplete="off" spellcheck="false" />
    <button type="submit">Search</button>
  </form>
  <a class="header-link" href="tags.html">Tags</a>
  <a class="header-link" href="book.pdf">PDF</a>
  <button id="theme-toggle" class="icon-button" type="button" aria-label="Switch between light and dark theme">
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M10 3.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"/></svg>
  </button>
</header>

<div class="layout">
<nav class="toc" id="site-toc" aria-label="Table of contents">
<ul>
{% for section in toc recursive %}
<li class="level-{{ loop.depth }}{{ isActive(section) }}{{ isCurrent(section) }}">
  <a href="{{ section.url }}">{{ tocEntry(section) }}</a>
  {% if section.tableofcontents and (section.level < 0 or section in links.breadcrumbs) %}
  <ul>{{ loop(section.tableofcontents) }}</ul>
  {% endif %}
</li>
{% endfor %}
</ul>
</nav>

<main class="content" id="main">
{% if obj.level >= 1 %}
<ol class="breadcrumbs">
{% for crumb in links.breadcrumbs %}
{% if not loop.last %}<li><a href="{{ crumb.url }}">{{ crumb.ref.textContent }} {{ crumb.tocEntry }}</a></li>{% endif %}
{% endfor %}
</ol>
{% endif %}

<article class="main-text">
{{ obj }}
</article>

{% if obj.tableofcontents and obj.level <= 0 %}
<nav class="local-toc" aria-label="Contents of this page">
<h2>Contents</h2>
<ol>
{% for section in obj.tableofcontents %}
<li><a href="{{ section.url }}">{{ tocEntry(section) }}</a></li>
{% endfor %}
</ol>
</nav>
{% endif %}

{% if obj.footnotes %}
<footer class="footnotes">
<ol>
{% for footnote in obj.footnotes %}
<li id="{{ footnote.id }}">{{ footnote }}</li>
{% endfor %}
</ol>
</footer>
{% endif %}

<nav class="page-nav" aria-label="Previous and next">
{% if links.prev.url %}<a class="prev" href="{{ links.prev.url }}"><span class="dir">Previous</span> {{ links.prev.title | striptags }}</a>{% endif %}
{% if links.next.url %}<a class="next" href="{{ links.next.url }}"><span class="dir">Next</span> {{ links.next.title | striptags }}</a>{% endif %}
</nav>
</main>
</div>

{% for js in rendererdata.get('js', []) %}
<script src="js/{{ js }}"></script>
{% endfor %}
</body>
</html>
